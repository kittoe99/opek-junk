# OpenAI — server-side only (/api routes + Supabase edge functions). Never use a VITE_ prefix.
OPENAI_API_KEY=your_openai_api_key_here

# Website database configuration (see docs/backend-status.md before setting these).
# The current CRM project is not compatible with the legacy website schema yet.
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Optional server-side fallbacks for /api routes (Vercel + local dev proxy)
SUPABASE_URL=your_supabase_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Stripe (use test keys from https://dashboard.stripe.com/test/apikeys)
# Client-side publishable key (pk_test_... for test mode)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# ElevenLabs ConvAI agent for the contact-page live chat widget (public agent ID is OK)
# VITE_ELEVENLABS_AGENT_ID=agent_5101kgxcwtkgek18m0j13cq16t3y
# Server-side secret key (sk_test_... for test mode) — never expose to the browser
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
# Webhook signing secret (whsec_...) from Stripe Dashboard or scripts/setup-stripe-webhook.mjs
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret_here
# Supabase service role — required for /api/stripe-webhook to write payment records
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Shared secret for POST /api/create-booking (send as "Authorization: Bearer <secret>").
# The endpoint rejects every request while this is unset.
BOOKING_API_SECRET=generate_a_long_random_string

# The legacy DigitalOcean SMS bridge has been retired. Do not configure its
# OPEK_SMS_URL / OPEK_SMS_API_KEY; migrate quote delivery to the current CRM API.
